# Local Helper settings. Copy to .env and fill in. .env is gitignored.
# OpenAI-compatible server for the "Local" AI provider (e.g. LiteLLM or Ollama).
STUDIO_LLM_BASE_URL=http://your-llm-server:3300/
STUDIO_LLM_API_KEY=
# Comma-separated models offered in the portal when the server cannot list them.
STUDIO_LLM_MODELS=qwen3.5:35b,gemma4:26b
STUDIO_LLM_EMBEDDING_MODEL=
# Optional tuning
# STUDIO_LLM_TIMEOUT=900
# STUDIO_LLM_CONCURRENCY=2
# STUDIO_LLM_CONTEXT=32768
